# Ascendant — environment variable NAMES ONLY. Never commit a value here (§15.4).
# All real credentials live in Vercel env vars.

# ── database ────────────────────────────────────────────────────────────────────
# Neon pooled connection string. db() throws loudly rather than connecting to
# nothing, so an unset value fails visibly instead of silently returning no rows.
# The offline path (§13.1) is a local Postgres with pgvector plus the committed
# pg_dump: flip this to localhost and lose nothing.
DATABASE_URL=

# ── LLM providers, in cascade order (§10.1) ─────────────────────────────────────
# Groq limits are per ORGANIZATION, not per key — a second key buys nothing.
# Headroom comes from spreading across models, which is what the router does.
GROQ_API_KEY=
# Embeddings and overflow only. Gemini's free per-model limits are not published,
# so nothing critical depends on this rung.
GEMINI_API_KEY=
# 50 requests/day until $10 lifetime spend, then 1,000 (§13.5).
OPENROUTER_API_KEY=
# $5 one-time credit. Demo burst only — see ModelSpec.scarcity.
CEREBRAS_API_KEY=

# ── durable execution ──────────────────────────────────────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── GitHub App (§12.2 step 4) ──────────────────────────────────────────────────
# Permissions: Issues R/W, PRs R/W, Contents R/W, Metadata R.
# Contents R/W is the only write scope beyond issues and PRs.
GITHUB_APP_ID=
# Base64-encoded, decoded at runtime.
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_WEBHOOK_SECRET=
# Optional local-only fine-grained token. It is ignored unless the explicit flag is 1;
# never set either variable in production, where App installation tokens are minted.
GITHUB_TOKEN=
ASCENDANT_ALLOW_GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_DEFAULT_BRANCH=main

# ── sandbox (§12.4) ────────────────────────────────────────────────────────────
# Required production isolation. The experimental Actions driver is disabled unless
# explicitly opted in; production readiness requires E2B.
E2B_API_KEY=
E2B_TEMPLATE_ID=
ACTIONS_WORKFLOW=ascendant-sandbox.yml
ASCENDANT_ALLOW_ACTIONS_SANDBOX=
# The local driver runs generated code on this machine with NO isolation. Set to 1
# only for offline development; never on a deployed instance.
ASCENDANT_ALLOW_LOCAL_SANDBOX=

# ── remaining connectors ───────────────────────────────────────────────────────
LINEAR_API_KEY=
LINEAR_TEAM_ID=
LINEAR_WEBHOOK_SECRET=
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_SIGNING_SECRET=
# Comma-separated Slack member IDs allowed to approve/reject/escalate decisions.
SLACK_REVIEWER_IDS=
# OAuth stays in *testing* consent mode with readonly scopes, so no verification
# is needed. Gmail/Drive watch channels expire in <=7 days and are renewed by the
# 05:00 UTC maintenance cron.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_PUBSUB_TOPIC=

# ── app ────────────────────────────────────────────────────────────────────────
ASCENDANT_ORG_ID=org_demo
# Display name only; defaults to GITHUB_OWNER/GITHUB_REPO when unset.
ASCENDANT_WORKSPACE_NAME=
ASCENDANT_TEST_COMMAND=pnpm test
# `replay` serves stored agent_events at their original timing (§16.3 item 3).
# Genuine recorded output from a real run, replayed — say so if you use it.
DEMO_MODE=live

# ── dashboard auth (B8) ────────────────────────────────────────────────────────
# Shared secret for the HTTP Basic gate in apps/web/src/middleware.ts. Any username
# works; only the password is checked. The Policy view writes the autonomy threshold
# that gates autonomous action, so an unauthenticated deploy is a privilege
# escalation on the whole pipeline, not just an information leak.
#
# Unset is allowed for local `pnpm dev` (localhost, in-process PGlite). A PRODUCTION
# BUILD REFUSES TO COMPILE without it — see the guard at the top of next.config.ts.
ASCENDANT_DASHBOARD_PASSWORD=
# Set to 1 to build without the gate on purpose. Deliberate, and visible in shell
# history — do not put this in a deployment environment.
ASCENDANT_ALLOW_OPEN_DASHBOARD=

# ── offline / demo ─────────────────────────────────────────────────────────────
# Real inference is OPT-IN, not implied by a key being present. `pnpm demo` and
# `pnpm seed:demo` run on recorded fixtures unless this is exactly 1.
#
# The reason is the ladder: the triage rungs are Groq at capability 0.95, while the
# OpenRouter rung is a 0.8 fallback sized for overflow. A shell holding only
# OPENROUTER_API_KEY used to count as fully live and ran every scenario on the
# weakest rung, losing two of the five demo beats — a valid key producing a worse
# result than no key. Everything around the reasoning (policy rules, all four
# retrieval sources, citation validation, confidence, banding, the ESCALATE
# overrides) is the real code path either way, and fixtures are labelled `fixture:*`
# wherever they surface.
ASCENDANT_LIVE=
# Opens a real Postgres in-process via PGlite. Ignored when DATABASE_URL is set.
ASCENDANT_LOCAL_DB=1
