# Ascendant — environment variable NAMES ONLY. Never commit a value here (§15.4).
# All real credentials live in Vercel env vars.

# ── database ────────────────────────────────────────────────────────────────────
# Neon pooled connection string. db() throws loudly rather than connecting to
# nothing, so an unset value fails visibly instead of silently returning no rows.
# The offline path (§13.1) is a local Postgres with pgvector plus the committed
# pg_dump: flip this to localhost and lose nothing.
DATABASE_URL=

# ── LLM providers, in cascade order (§10.1) ─────────────────────────────────────
# Groq limits are per ORGANIZATION, not per key — a second key buys nothing.
# Headroom comes from spreading across models, which is what the router does.
GROQ_API_KEY=
# Embeddings and overflow only. Gemini's free per-model limits are not published,
# so nothing critical depends on this rung.
GEMINI_API_KEY=
# 50 requests/day until $10 lifetime spend, then 1,000 (§13.5).
OPENROUTER_API_KEY=
# $5 one-time credit. Demo burst only — see ModelSpec.scarcity.
CEREBRAS_API_KEY=

# ── durable execution ──────────────────────────────────────────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── GitHub App (§12.2 step 4) ──────────────────────────────────────────────────
# Permissions: Issues R/W, PRs R/W, Contents R/W, Metadata R.
# Contents R/W is the only write scope beyond issues and PRs.
GITHUB_APP_ID=
# Base64-encoded, decoded at runtime.
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_WEBHOOK_SECRET=
# Installation token, minted per-run with a 1-hour expiry. Never a long-lived PAT.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_DEFAULT_BRANCH=main

# ── sandbox (§12.4) ────────────────────────────────────────────────────────────
# E2B primary. Falls back to the GitHub Actions driver when unset, so an exhausted
# credit degrades the pipeline to slower rather than broken.
E2B_API_KEY=
E2B_TEMPLATE_ID=
ACTIONS_WORKFLOW=ascendant-sandbox.yml
# The local driver runs generated code on this machine with NO isolation. Set to 1
# only for offline development; never on a deployed instance.
ASCENDANT_ALLOW_LOCAL_SANDBOX=

# ── remaining connectors ───────────────────────────────────────────────────────
LINEAR_API_KEY=
LINEAR_WEBHOOK_SECRET=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# OAuth stays in *testing* consent mode with readonly scopes, so no verification
# is needed. Gmail/Drive watch channels expire in <=7 days and are renewed by the
# 05:00 UTC maintenance cron.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_PUBSUB_TOPIC=

# ── app ────────────────────────────────────────────────────────────────────────
ASCENDANT_ORG_ID=org_demo
ASCENDANT_TEST_COMMAND=pnpm test
# `replay` serves stored agent_events at their original timing (§16.3 item 3).
# Genuine recorded output from a real run, replayed — say so if you use it.
DEMO_MODE=live
