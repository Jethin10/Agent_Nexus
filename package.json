{
  "name": "ascendant",
  "private": true,
  "version": "0.1.0",
  "description": "Decides what to build. Then builds it.",
  "packageManager": "pnpm@9.15.4",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "dev": "pnpm --filter @ascendant/web dev",
    "web:build": "pnpm --filter @ascendant/web build",
    "db:generate": "pnpm --filter @ascendant/db generate",
    "db:push": "pnpm --filter @ascendant/db push",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "eval": "tsx scripts/eval.ts"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "3.0.4"
  }
}
