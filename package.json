{
  "name": "ascendant",
  "private": true,
  "version": "0.1.0",
  "description": "Decides what to build. Then builds it.",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "dev": "cross-env ASCENDANT_LOCAL_DB=1 INNGEST_DEV=1 pnpm --filter @ascendant/web dev",
    "dev:inngest": "npx --ignore-scripts=false inngest-cli@latest dev --no-discovery -u http://localhost:3000/api/inngest",
    "dev:replay": "cross-env ASCENDANT_LOCAL_DB=1 DEMO_MODE=replay pnpm --filter @ascendant/web dev",
    "web:build": "pnpm --filter @ascendant/web build",
    "db:generate": "pnpm --filter @ascendant/db generate",
    "db:push": "pnpm --filter @ascendant/db push",
    "db:migrate": "pnpm --filter @ascendant/db exec drizzle-kit migrate",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "demo": "tsx scripts/demo.ts",
    "demo:build": "tsx scripts/demo-build.ts",
    "integrations:check": "tsx scripts/integrations-check.ts",
    "deploy:check": "tsx scripts/deploy-check.ts",
    "corpus:sync": "tsx scripts/sync-github-corpus.ts",
    "eval": "tsx scripts/eval.ts"
  },
  "devDependencies": {
    "@types/node": "22.10.7",
    "cross-env": "7.0.3",
    "tsx": "4.19.2",
    "typescript": "5.8.3",
    "vitest": "3.0.4"
  },
  "pnpm": {
    "peerDependencyRules": {
      "//": "drizzle-orm declares every driver as an optional peer, so adding @electric-sql/pglite made pnpm resolve a SECOND drizzle-orm instance for @ascendant/db. Two copies means two structurally identical but nominally distinct SQL<> types, and every query passed across a package boundary fails to typecheck. Ignoring the peer keeps one instance for the whole workspace; the driver is imported directly by db/src/local.ts either way.",
      "ignoreMissing": [],
      "allowedVersions": {}
    },
    "overrides": {
      "drizzle-orm": "0.45.2",
      "postcss": "8.5.18",
      "sharp": "0.35.0"
    }
  }
}
